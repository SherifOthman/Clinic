# ---- Cloned reference repos (kept locally as a feature reference, never committed) ----
reference/

# ---- .NET ----
**/bin/
**/obj/
*.user
*.suo
backend/.vs/

# ---- Test output ----
# Generated by: dotnet test --collect:"XPlat Code Coverage"
**/TestResults/

# ---- Frontend ----
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.vite/
frontend/coverage/
frontend/*.tsbuildinfo

# ---- App runtime data ----
**/data/*.db
**/data/*.db-*

# ---- Build output served by the API (generated by: npm run build) ----
# The wwwroot directory is recreated from source on every build.
# A .gitkeep placeholder is preserved so the directory exists after a fresh clone.
**/wwwroot/*
!**/wwwroot/.gitkeep

# ---- OS-generated junk ----
Thumbs.db
desktop.ini
.DS_Store
